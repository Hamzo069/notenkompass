{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notenkompass",
  "version": "0.1.0",
  "identifier": "io.github.hamzo069.notenkompass",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "node ../scripts/copy-web-assets.cjs",
    "beforeBuildCommand": "node ../scripts/copy-web-assets.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "Notenkompass",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
